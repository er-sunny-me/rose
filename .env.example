# ── AI Providers (at least one) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model selection
MODEL_LIVE=models/gemini-3.1-flash-live-preview
MODEL_TEXT=gemini-2.0-flash-lite

# ── Voice ───────────────────────────────────────────────────
VOICE_NAME=Puck
DEFAULT_MIC="Noise Earbuds"
ENABLE_SCREEN_SHARE=true
SCREEN_CAPTURE_INTERVAL_MS=2000

# ── Integrations (Phase 34) ─────────────────────────────────
# GitHub: personal access token for issues/PR/workflow access
# GITHUB_TOKEN=
# Google (Gmail/Calendar): path to OAuth tokens JSON
# GOOGLE_CREDENTIALS=C:\Users\alone\.rose\google-tokens.json
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Local models (Phase 34) ─────────────────────────────────
# OLLAMA_HOST=http://127.0.0.1:11434
# Set false to skip Ollama discovery entirely
# ROSE_ENABLE_OLLAMA=true
# Offline mode: only local providers/tools are used
# ROSE_OFFLINE=false

# ── Embeddings / vector memory (Phase 34) ───────────────────
# gemini (default when GEMINI_API_KEY present) | local
ROSE_EMBEDDING_PROVIDER=local

# ── Browser automation (Phase 34) ───────────────────────────
# Comma-separated domain allow/deny lists (deny wins)
# ROSE_BROWSER_ALLOW_DOMAINS=
# ROSE_BROWSER_DENY_DOMAINS=facebook.com,instagram.com
# ROSE_BROWSER_ALLOW_DOWNLOADS=false

# ── Command sandbox (Phase 34) ──────────────────────────────
# Extra executables the sandbox may run without approval
# ROSE_SANDBOX_EXTRA_ALLOWLIST=ffmpeg,ffplay

# ── Server auth (Phase 34) ──────────────────────────────────
# Pre-share the API token instead of reading .rose/auth-token
# ROSE_API_TOKEN=
