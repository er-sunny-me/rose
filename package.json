{
  "name": "rose-ai",
  "version": "1.1.3",
  "description": "General-purpose local-first AI agent platform with tools, memory, automation, research, multi-agent orchestration and Gemini Live.",
  "main": "dist/index.js",
  "bin": {
    "rose": "dist/cli.js"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "start": "node dist/index.js",
    "pack:dry": "npm pack --dry-run",
    "pack:build": "npm run build && npm pack",
    "dev": "tsx src/index.js",
    "test:e2e": "tsx src/testing/e2e.ts",
    "test:all": "npm run test:e2e"
  },
  "keywords": [
    "gemini",
    "voice",
    "chat",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@inquirer/prompts": "^8.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "antigravity-proxy-ai": "*",
    "chalk": "^5.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "ora": "^8.0.1",
    "screenshot-desktop": "^1.15.6",
    "uuid": "^14.0.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.4"
  }
}
